{
  "name": "HAPatchY",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspaces/hapatchy",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/hapatchy,type=bind",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "overrideCommand": false,
  "init": true,
  "shutdownAction": "stopContainer",
  "runArgs": [
    "--stop-timeout=40"
  ],
  "forwardPorts": [
    8123
  ],
  "portsAttributes": {
    "8123": {
      "label": "Development Home Assistant",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash .devcontainer/scripts/wait-ha.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "remote.localPortHost": "localhost"
      }
    }
  },
  "remoteEnv": {
    "PATH": "/workspaces/hapatchy/.venv/bin:${containerEnv:PATH}"
  }
}
